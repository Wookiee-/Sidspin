#!/bin/bash
# Chroot hook: locale and timezone for the live session.

set -e

echo "sidspin: generating locales"
echo "en_US.UTF-8 UTF-8" > /etc/locale.gen
locale-gen
update-locale LANG=en_US.UTF-8

ln -sf /usr/share/zoneinfo/UTC /etc/localtime
echo "UTC" > /etc/timezone

echo "sidspin: locale and timezone set"
