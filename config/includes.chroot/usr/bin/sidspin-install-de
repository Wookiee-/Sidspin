#!/bin/sh
# SidSpin — install the desktop environment the user selected.
#
# Calamares runs this inside the target system (chroot):
#
#     sidspin-install-de <desktop-id>[:<profile>]
#
# <desktop-id> is one of kde-plasma, gnome, xfce, mate, lxqt, cinnamon.
# <profile> is "full" (the desktop with its usual applications) or
# "minimal" (the desktop on its own).  It defaults to "full".
#
# The live image ships KDE Plasma, so the target already contains it.  When
# a different desktop is picked we install it, remove the desktops that are
# not wanted, and point the display manager at the one that was chosen.
#
# Nothing here is allowed to abort the installation: a desktop that fails to
# install leaves the user with a working system and a note in the log.

set -u

ARG="${1:-kde-plasma:full}"
DE="${ARG%%:*}"
PROFILE="${ARG##*:}"
if [ "$PROFILE" = "$DE" ]; then
    # No ":" in the argument, so no profile was given.
    PROFILE="full"
fi

log() { echo "sidspin-install-de: $*"; }

is_installed() {
    dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "ok installed"
}

# Install packages into the target.  Never fatal.
install_packages() {
    [ "$#" -gt 0 ] || return 0
    log "installing: $*"
    DEBIAN_FRONTEND=noninteractive apt-get -q -y install "$@" \
        || log "warning: could not install $*"
}

# Remove packages from the target.  Never fatal.
purge_packages() {
    [ "$#" -gt 0 ] || return 0
    for pkg in "$@"; do
        if is_installed "$pkg"; then
            log "removing $pkg"
            DEBIAN_FRONTEND=noninteractive apt-get -q -y purge "$pkg" >/dev/null 2>&1 \
                || log "warning: could not remove $pkg"
        fi
    done
}

# Point the system at the display manager of the chosen desktop.
set_display_manager() {
    binary="$1"
    service="$2"

    if [ ! -e "$binary" ]; then
        log "warning: $binary is missing, leaving the display manager alone"
        return 0
    fi

    update-alternatives --set /etc/X11/default-display-manager "$binary" >/dev/null 2>&1 || {
        rm -f /etc/X11/default-display-manager
        ln -sf "$binary" /etc/X11/default-display-manager
    }

    systemctl enable "$service" >/dev/null 2>&1 || true
    log "display manager: $binary ($service)"
}

# The packages that make up each desktop.  The first of each pair is the
# bare desktop, the second is Debian's "install this desktop" task.
PLASMA_PKGS="kde-plasma-desktop kde-baseapps plasma-desktop plasma-workspace plasma-nm kwin-x11 xdg-desktop-portal-kde"
GNOME_PKGS="gnome-core task-gnome-desktop gdm3"
XFCE_PKGS="xfce4 xfce4-terminal task-xfce-desktop lightdm"
MATE_PKGS="mate-desktop-environment-core mate-terminal task-mate-desktop"
LXQT_PKGS="lxqt-core lxqt-panel task-lxqt-desktop"
CINNAMON_PKGS="cinnamon task-cinnamon-desktop"

case "$DE" in
    kde-plasma)
        DE_DM="/usr/bin/sddm"
        DE_SERVICE="sddm"
        DE_REMOVE="$GNOME_PKGS $XFCE_PKGS $MATE_PKGS $LXQT_PKGS $CINNAMON_PKGS"
        if [ "$PROFILE" = "minimal" ]; then
            # The shell without the application suite that came with it.
            DE_PACKAGES="plasma-desktop plasma-workspace kwin-x11 sddm plasma-nm xdg-desktop-portal-kde"
            DE_REMOVE="$DE_REMOVE kde-plasma-desktop kde-baseapps"
        else
            DE_PACKAGES="kde-plasma-desktop kwin-x11 sddm plasma-nm xdg-desktop-portal-kde"
        fi
        ;;
    gnome)
        DE_DM="/usr/bin/gdm3"
        DE_SERVICE="gdm3"
        DE_REMOVE="$PLASMA_PKGS $XFCE_PKGS $MATE_PKGS $LXQT_PKGS $CINNAMON_PKGS"
        if [ "$PROFILE" = "minimal" ]; then
            DE_PACKAGES="gnome-core gdm3"
        else
            DE_PACKAGES="task-gnome-desktop gdm3"
        fi
        ;;
    xfce)
        DE_DM="/usr/sbin/lightdm"
        DE_SERVICE="lightdm"
        DE_REMOVE="$PLASMA_PKGS $GNOME_PKGS $MATE_PKGS $LXQT_PKGS $CINNAMON_PKGS"
        if [ "$PROFILE" = "minimal" ]; then
            DE_PACKAGES="xfce4 xfce4-terminal lightdm"
        else
            DE_PACKAGES="task-xfce-desktop lightdm"
        fi
        ;;
    mate)
        DE_DM="/usr/sbin/lightdm"
        DE_SERVICE="lightdm"
        DE_REMOVE="$PLASMA_PKGS $GNOME_PKGS $XFCE_PKGS $LXQT_PKGS $CINNAMON_PKGS"
        if [ "$PROFILE" = "minimal" ]; then
            DE_PACKAGES="mate-desktop-environment-core mate-terminal lightdm"
        else
            DE_PACKAGES="task-mate-desktop lightdm"
        fi
        ;;
    lxqt)
        DE_DM="/usr/bin/sddm"
        DE_SERVICE="sddm"
        DE_REMOVE="$PLASMA_PKGS $GNOME_PKGS $XFCE_PKGS $MATE_PKGS $CINNAMON_PKGS"
        if [ "$PROFILE" = "minimal" ]; then
            DE_PACKAGES="lxqt-core lxqt-panel qterminal sddm"
        else
            DE_PACKAGES="task-lxqt-desktop sddm"
        fi
        ;;
    cinnamon)
        DE_DM="/usr/sbin/lightdm"
        DE_SERVICE="lightdm"
        DE_REMOVE="$PLASMA_PKGS $GNOME_PKGS $XFCE_PKGS $MATE_PKGS $LXQT_PKGS"
        if [ "$PROFILE" = "minimal" ]; then
            DE_PACKAGES="cinnamon lightdm"
        else
            DE_PACKAGES="task-cinnamon-desktop lightdm"
        fi
        ;;
    *)
        log "unknown desktop '$DE', keeping KDE Plasma"
        DE="kde-plasma"
        PROFILE="full"
        DE_PACKAGES="kde-plasma-desktop kwin-x11 sddm plasma-nm xdg-desktop-portal-kde"
        DE_REMOVE="$GNOME_PKGS $XFCE_PKGS $MATE_PKGS $LXQT_PKGS $CINNAMON_PKGS"
        DE_DM="/usr/bin/sddm"
        DE_SERVICE="sddm"
        ;;
esac

log "installing desktop: $DE ($PROFILE)"

# The package module already refreshed the package lists, but the target
# may have been offline for a moment.
DEBIAN_FRONTEND=noninteractive apt-get -q -y update >/dev/null 2>&1 || true

# Remove the desktops that are not wanted first, so that installing the
# new one cannot be undone by the removal.
purge_packages $DE_REMOVE

install_packages $DE_PACKAGES

# Clean up whatever the removed desktops left behind (the Plasma stack is
# pulled in as a dependency of kde-plasma-desktop, so it only goes away
# once the metapackage is gone).
log "cleaning up unused packages"
DEBIAN_FRONTEND=noninteractive apt-get -q -y autoremove >/dev/null 2>&1 \
    || log "warning: autoremove failed"

set_display_manager "$DE_DM" "$DE_SERVICE"

# The live session auto-logs in as "user"; the installed system has a real
# account and should show a normal login screen.
rm -f /etc/sddm.conf.d/99-sidspin-live.conf
if [ "$DE" = "kde-plasma" ]; then
    mkdir -p /etc/sddm.conf.d
    cat > /etc/sddm.conf.d/99-sidspin.conf <<'EOF'
[Theme]
Current=breeze

[Autologin]
Session=plasma.desktop
EOF
fi

echo "$DE:$PROFILE" > /etc/sidspin-desktop
log "done: $DE ($PROFILE)"
